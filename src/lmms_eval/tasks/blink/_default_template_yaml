dataset_path: BLINK-Benchmark/BLINK
test_split: val
output_type: generate_until
doc_to_visual: !function utils.blink_doc_to_visual
doc_to_text: !function utils.blink_doc_to_text
doc_to_target: "answer"

process_results: !function utils.blink_process_results

metric_list:
  - metric: blink_acc
    aggregation: !function utils.blink_aggregate_results
    higher_is_better: true

lmms_eval_specific_kwargs:
  default:
    pre_prompt: "Return exactly one uppercase option letter from the given choices ({}). Do not output any explanation, punctuation, or extra text.\n"
    mca_post_prompt: "Answer with the option's letter from the given choices directly."
    post_prompt: ""

# Prompt suffix, stop strings and parser move together via BLINK_PROTOCOL
# (default "original" = letter-only pre_prompt + start-of-string letter;
# set "spatialstack" for VSI-Bench boxed last-line).
generation_kwargs: !function utils.BLINK_GENERATION_KWARGS
